APP_NAME=ZedProxy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Trusted reverse proxies allowed to set X-Forwarded-* headers. Comma-separated
# IPs/CIDRs. Leave empty for direct access (no proxy). Never use "*".
#   Nginx on same host:  TRUSTED_PROXIES=127.0.0.1,::1
#   Known load balancer: TRUSTED_PROXIES=10.0.0.0/8
TRUSTED_PROXIES=127.0.0.1,::1
# Trust Cloudflare edge ranges + use CF-Connecting-IP (only when peer is Cloudflare).
TRUST_CLOUDFLARE_PROXIES=false
# Log resolved client IP vs proxy IP separately at debug level.
PROXY_LOG_RESOLUTION=false

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

# Application timezone — used by the scheduler (dailyAt/hourly) and all date
# functions. Keep the SERVER clock (and cron) in sync; schedule times below are
# interpreted in THIS timezone. UTC is recommended to avoid DST surprises.
APP_TIMEZONE=UTC

# Scheduler lock/heartbeat store. File-based so withoutOverlapping() and the
# heartbeat keep working during a Redis outage. Threshold = seconds of silence
# before the scheduler is reported as down.
SCHEDULER_LOCK_STORE=file
SCHEDULER_HEARTBEAT_STORE=file
SCHEDULER_HEARTBEAT_THRESHOLD=300

# Discount reservations: how long a `reserved` code holds capacity before an
# abandoned reservation is expired (minutes), and bounded deadlock retry.
DISCOUNT_RESERVATION_TTL_MINUTES=30
DISCOUNT_DEADLOCK_RETRIES=3

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zedproxy
DB_USERNAME=zedproxy_user
DB_PASSWORD=GENERATED_SECURE_PASSWORD

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=zedproxy_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Outbound mail ────────────────────────────────────────────────────────────
# MAIL_MAILER=log writes messages to the log only (nothing is delivered) —
# keep it until you deliberately configure a real transport (e.g. smtp).
# Email-OTP verification treats log/array as UNCONFIGURED in production and
# cannot be made "required" until a usable transport + From address exist.
# SMTP credentials live ONLY here — never in the database or the admin panel.
# After changing mail settings run: php artisan optimize:clear &&
# php artisan config:cache, then restart the queue workers.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
# SMTP PER-OPERATION timeout in seconds (each read/write, bounded 1-20).
MAIL_TIMEOUT=10

VITE_APP_NAME="${APP_NAME}"

# CentralPay rial/toman payment gateway
CENTRALPAY_ENABLED=false
CENTRALPAY_API_KEY=
CENTRALPAY_BASE_URL=https://centralapi.org/webservice/basic
CENTRALPAY_TYPE=deposit
CENTRALPAY_AMOUNT_UNIT=TOMAN
CENTRALPAY_CALLBACK_PATH=/payments/centralpay/callback
